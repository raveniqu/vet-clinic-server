{
	"name": "vet-clinic-server",
	"version": "1.0.50",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun src/index.ts",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check --write .",
		"format": "bunx biome format --write .",
		"test": "bun test --pass-with-no-tests --check",
		"db:types": "bun --env-file=.env.local x kysely-codegen --dialect postgres --url='env(DATABASE_RW_URL)' --out-file src/shared/db/generated/db.d.ts",
		"prepare:husky": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": ["bunx biome check --write --no-errors-on-unmatched"]
	},
	"dependencies": {
		"elysia": "^1.4.0",
		"@elysiajs/cors": "^1.3.0",
		"@logtape/elysia": "^2.4.0",
		"@logtape/logtape": "^2.4.0",
		"kysely": "^0.29.5",
		"kysely-postgres-js": "^2.0.0",
		"postgres": "^3.4.5",
		"neverthrow": "^8.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/bun": "^1.4.0",
		"husky": "^9.1.7",
		"kysely-codegen": "^0.20.0",
		"lint-staged": "^16.2.7",
		"typescript": "^7.0.0"
	}
}
