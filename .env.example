# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# App
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Postgres
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATABASE_RW_URL=postgres://vet_serverapp_rw:vet_serverapp_rw@localhost:5432/vet_clinic_dev?sslmode=prefer
DATABASE_RO_URL=postgres://vet_serverapp_ro:vet_serverapp_ro@localhost:5432/vet_clinic_dev?sslmode=prefer
# Pool sizing (DEV: 1/1; Production: 5/5; leave Postgres max_connections=100 default)
DATABASE_RW_MAX_POOL=1
DATABASE_RO_MAX_POOL=1
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_RW_STATEMENT_TIMEOUT_MS=10000
DATABASE_RO_STATEMENT_TIMEOUT_MS=5000
DATABASE_PREPARE=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Tax ID Encryption (ADR-0002)
# Generate each key with: openssl rand -base64 32
# TAX_ID_ENCRYPTION_KEY: exact 32 decoded bytes (AES-256-GCM)
# TAX_ID_HMAC_KEY: at least 32 decoded bytes (HMAC-SHA256 blind index)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TAX_ID_ENCRYPTION_KEY=
TAX_ID_HMAC_KEY=
